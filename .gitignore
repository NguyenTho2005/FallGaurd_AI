# ---------------------------------------------------------------------------
# Secrets -- never commit
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# virtual environments
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Test / tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
.tox/

# ---------------------------------------------------------------------------
# ML artefacts -- large, regenerable
# ---------------------------------------------------------------------------
models/*.keras
models/*.h5
models/*.hdf5
models/*.pt
models/*.pth
models/*.ckpt
models/*.tflite
models/*.meta.json
models/*.npz
*.keras
*.h5
checkpoints/

# MediaPipe assets are fetched by scripts/download_mediapipe_model.py
ai/pose/mediapipe_models/*.task
ai/pose/mediapipe_models/*.tflite

# ---------------------------------------------------------------------------
# Data -- raw video and generated landmarks are never committed
# ---------------------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/samples/*
!data/samples/.gitkeep
data/samples/videos/*
!data/samples/videos/.gitkeep
data/*.db
data/*.sqlite
data/*.sqlite3
*.mp4
*.avi
*.mov
*.mkv
*.npy
*.npz
*.parquet

# Privacy guard: FallGuard AI must not retain raw footage.
data/**/*.mp4
data/**/*.avi
data/**/*.mov

# ---------------------------------------------------------------------------
# Generated reports / logs
# ---------------------------------------------------------------------------
reports/*
!reports/.gitkeep
logs/
*.log

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
