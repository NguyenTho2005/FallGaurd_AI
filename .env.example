# ---------------------------------------------------------------------------
# FallGuard AI -- example environment file
#
#   cp .env.example .env
#
# .env is git-ignored and must NEVER be committed.
# All variables below are optional; the defaults shown are the ones applied when
# the variable is absent (see ai/config.py for the authoritative definitions).
# ---------------------------------------------------------------------------

# --- general ----------------------------------------------------------------
FALLGUARD_ENVIRONMENT=development
FALLGUARD_LOG_LEVEL=INFO
# FALLGUARD_LOG_FILE=logs/fallguard.log
FALLGUARD_LOG_JSON=false

# --- storage ----------------------------------------------------------------
FALLGUARD_DB_PATH=data/fallguard.db

# --- pose estimation --------------------------------------------------------
FALLGUARD_POSE_MODEL_PATH=ai/pose/mediapipe_models/pose_landmarker_lite.task
FALLGUARD_POSE_NUM_POSES=1
FALLGUARD_POSE_MIN_DETECTION_CONFIDENCE=0.5
FALLGUARD_POSE_MIN_PRESENCE_CONFIDENCE=0.5
FALLGUARD_POSE_MIN_TRACKING_CONFIDENCE=0.5

# --- preprocessing ----------------------------------------------------------
# Landmarks below this visibility are treated as missing.
FALLGUARD_MIN_LANDMARK_VISIBILITY=0.5
# Rotate the body so the torso axis is vertical (cancels camera tilt).
FALLGUARD_ROTATION_NORMALIZATION=true

# --- temporal sequence ------------------------------------------------------
FALLGUARD_SEQUENCE_LENGTH=30
FALLGUARD_MAX_MISSING_RATIO=0.5
FALLGUARD_TARGET_FPS=30

# --- model ------------------------------------------------------------------
# keras = load MODEL_PATH; mock = deterministic heuristic, used for tests/demo
# when no trained checkpoint is available.
FALLGUARD_MODEL_BACKEND=keras
FALLGUARD_MODEL_PATH=models/fallguard_lstm.keras
FALLGUARD_MODEL_METADATA_PATH=models/fallguard_lstm.meta.json
FALLGUARD_LSTM_UNITS=64
FALLGUARD_BILSTM_UNITS=64
FALLGUARD_DROPOUT_RATE=0.3

# --- fall event confirmation ------------------------------------------------
FALLGUARD_CONFIDENCE_THRESHOLD=0.80
FALLGUARD_MIN_FALL_FRAMES=8
FALLGUARD_COOLDOWN_SECONDS=30

# --- camera -----------------------------------------------------------------
# 0 = default webcam.  An RTSP/HTTP URL or a path to a video file also works.
FALLGUARD_CAMERA_SOURCE=0
FALLGUARD_CAMERA_ID=camera_01
FALLGUARD_FRAME_WIDTH=640
FALLGUARD_FRAME_HEIGHT=480
# Run the camera monitor thread inside the API process (off by default).
FALLGUARD_ENABLE_MONITOR=false

# --- privacy ----------------------------------------------------------------
# Hard requirement: raw frames are processed in memory and never stored.
FALLGUARD_STORE_RAW_VIDEO=false

# --- api --------------------------------------------------------------------
FALLGUARD_API_HOST=0.0.0.0
FALLGUARD_API_PORT=8000

# --- telegram alerts --------------------------------------------------------
# Create a bot with @BotFather and get your chat id from @userinfobot.
# Leave the token empty to run alerts in dry-run mode (rendered + logged, not sent).
FALLGUARD_TELEGRAM_BOT_TOKEN=
FALLGUARD_TELEGRAM_CHAT_ID=
FALLGUARD_TELEGRAM_ENABLED=true
FALLGUARD_TELEGRAM_DRY_RUN=true
FALLGUARD_TELEGRAM_TIMEOUT_SECONDS=10
FALLGUARD_TELEGRAM_MAX_RETRIES=3

# --- training ---------------------------------------------------------------
FALLGUARD_BATCH_SIZE=32
FALLGUARD_EPOCHS=20
FALLGUARD_LEARNING_RATE=0.001
FALLGUARD_VALIDATION_SPLIT=0.2
FALLGUARD_TEST_SPLIT=0.2
FALLGUARD_EARLY_STOPPING_PATIENCE=5
FALLGUARD_RANDOM_SEED=20240917
